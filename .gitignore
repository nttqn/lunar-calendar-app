# Flutter/Dart build output
.dart_tool/
.packages
build/
*.g.dart

# Platform folders are generated by CI (flutter create) so the repo
# doesn't need Flutter/Android SDK installed locally. See README.md.
/android/
/ios/
/macos/
/linux/
/windows/
/web/

# Release signing — never commit these. See README.md.
*.jks
*.keystore
key.properties

# iOS signing material — never commit these either.
*.p12
*.p12.b64
*.p8
*.p8.b64
*.cer
*.certSigningRequest
*.mobileprovision
*.mobileprovision.b64
*.pem
ios-dist.key
profile.plist

# IDE
.idea/
.vscode/
*.iml

# Misc
.flutter-plugins
.flutter-plugins-dependencies
.metadata
pubspec.lock
